static var dict := {}   # length -> PackedStringArray of words
static var pre := {}    # length -> Dictionary of every prefix (String -> true)


static func ensure_loaded() -> void:
	if not dict.is_empty():
		return
	for n: int in RAW:
		var list := PackedStringArray()
		var seen := {}
		for w: String in (RAW[n] as String).replace("\n", " ").split(" ", false):
			w = w.strip_edges().to_upper()
			if w.length() == n and not seen.has(w):
				seen[w] = true
				list.append(w)
		dict[n] = list
		var p := {}
		for w in list:
			for i in range(1, n + 1):
				p[w.substr(0, i)] = true
		pre[n] = p


static func is_prefix(p: String, n: int) -> bool:
	return (pre[n] as Dictionary).has(p)


## Letters that keep `p` on the way to a real n-letter word.
static func next_letters(p: String, n: int) -> Array[String]:
	var out: Array[String] = []
	for i in 26:
		var c := String.chr(65 + i)
		if is_prefix(p + c, n):
			out.append(c)
	return out


static func words_from(p: String, n: int) -> Array[String]:
	var out: Array[String] = []
	for w in dict[n]:
		if w.begins_with(p):
			out.append(w)
	return out
